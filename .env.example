# StockPilot Daily
#
# Copy to .env.local and fill in. Never commit the real file.
# The spine also reads ~/Documents/stockpilot/.env for the Notion credentials,
# so on the pipeline machine only the Supabase values below are needed here.

# --- Supabase (the spine) -------------------------------------------------
# Leave both unset to run against local files in data/decks/.
# The service role key bypasses RLS and is SERVER-ONLY. It must never be
# prefixed NEXT_PUBLIC_ and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notion (deck ingest, optional) ---------------------------------------
# Only needed if this machine does not have ~/Documents/stockpilot/.env.
NOTION_TOKEN=
NOTION_REPORT_DATABASE_ID=

# --- Pipeline location (optional) -----------------------------------------
# Defaults to ~/Documents/stockpilot
STOCKPILOT_DIR=

# --- Jev question router (optional) ---------------------------------------
# TypeSafe API key (console.typesafe.ai/keys). Unset, the keyword router answers.
# Paste the bare key: no quotes and no <angle brackets>. Server-only; never NEXT_PUBLIC_.
JEV_API_KEY=
