{
  "name": "stockpilot-daily",
  "version": "1.0.0",
  "description": "StockPilot Daily \u2014 the daily agent run, rendered as a broadcast-style video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@notionhq/client": "2.2.15",
    "@remotion/cli": "4.0.513",
    "@remotion/google-fonts": "4.0.513",
    "@remotion/player": "4.0.513",
    "@remotion/tailwind-v4": "4.0.513",
    "@supabase/supabase-js": "2.48.1",
    "dotenv": "16.4.5",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.513",
    "tailwindcss": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.513",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "supabase": "2.115.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "next dev",
    "studio": "remotion studio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts components app && tsc",
    "check": "tsx scripts/check-sources.ts",
    "sync": "tsx scripts/sync.ts",
    "daily": "tsx scripts/daily.ts",
    "deck": "tsx src/spine/fetch-deck.ts",
    "render": "remotion render StockPilotDaily out/stockpilot-vertical.mp4 --props=data/deck.json",
    "render:landscape": "remotion render StockPilotDailyLandscape out/stockpilot-landscape.mp4 --props=data/deck.json",
    "artifact": "tsx scripts/build-artifact.ts",
    "db:start": "supabase start",
    "db:env": "./scripts/use-local-supabase.sh",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "bundle": "remotion bundle",
    "upgrade": "remotion upgrade"
  },
  "sideEffects": [
    "*.css"
  ]
}
