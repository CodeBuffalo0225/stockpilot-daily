# Vercel uploads from this machine, not from git, because the decks in data/decks/
# are gitignored by design (the pipeline reports only exist here — see AGENTS.md).
# A .vercelignore replaces .gitignore for uploads, so data/decks/ ships with the build.
node_modules
.next
out
.git
.env
.env*.local
supabase/.temp
supabase/.branches
tsconfig.tsbuildinfo
*.log
.DS_Store

# Dev tooling, never part of the app. .gauntlet/bars holds crops of Robinhood's App Store
# marketing assets kept for internal design comparison only, which must never ship in any
# build - and until 2026-09-23 they were in every CLI upload's source tree (not served,
# but uploaded). .claude holds agent definitions.
.gauntlet
.claude

# Local run log of the weekday publish; not part of the app.
data/publish-log.jsonl

# Never upload: the state worktree and cloud pipeline copy hold the pipeline database.
.state
.pipeline
.state-backups
.state-gen
.github
